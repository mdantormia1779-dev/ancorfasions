datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  email      String?  @unique
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  phone      String?
  avatarUrl  String?  @map("avatar_url")
  roleId     String?  @map("role_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  role             Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  bookmarks        UserBookmark[]
  notifications    Notification[]
  assignedTasks    Task[]             @relation("TaskAssignee")
  createdTasks     Task[]             @relation("TaskCreator")
  assignedTickets  SupportTicket[]    @relation("TicketAssignee")
  sentMessages     TicketMessage[]
  logs             CommunicationLog[]
  auditLogs        AuditLog[]

  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profiles    Profile[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  href      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, href])
  @@map("user_bookmarks")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String    @default("system")
  linkUrl   String?   @map("link_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      String    @default("pending") // pending, in_progress, completed, cancelled
  priority    String    @default("medium")  // low, medium, high, urgent
  assigneeId  String?   @map("assignee_id") @db.Uuid
  createdById String?   @map("created_by") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignee Profile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  Profile? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS
// ─────────────────────────────────────────────────────────────────────────────

model CMSPage {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  slug            String    @unique
  content         String?
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isPublished     Boolean   @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  blocks CMSPageBlock[]

  @@map("cms_pages")
}

model CMSPageBlock {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @map("page_id") @db.Uuid
  sectionType  String   @map("section_type")
  contentJson  Json     @default("{}") @map("content_json")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  page CMSPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("cms_page_blocks")
}

model Banner {
  id           String    @id @default(uuid()) @db.Uuid
  title        String?
  subtitle     String?
  ctaText      String?   @map("cta_text")
  linkUrl      String    @map("link_url")
  imageUrl     String    @map("image_url")
  altText      String?   @map("alt_text")
  placement    String    @default("HERO")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  startDate    DateTime? @map("start_date") @db.Timestamptz(6)
  endDate      DateTime? @map("end_date") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("banners")
}

model BlogPost {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?   @map("cover_image")
  categoryId  String?   @map("category_id") @db.Uuid
  authorId    String?   @map("author_id") @db.Uuid
  tags        String[]  @default([])
  status      String    @default("draft") // draft, published, archived
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("blog_posts")
}

model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  posts BlogPost[]

  @@map("blog_categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM & SUPPORT
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id         String   @id @default(uuid()) @db.Uuid
  firstName  String   @map("first_name")
  lastName   String?  @map("last_name")
  email      String
  phone      String?
  company    String?  @map("company_name")
  source     String   @default("Direct")
  status     String   @default("new") // new, contacted, qualified, converted, lost
  assignedTo String?  @map("assigned_to") @db.Uuid
  score      Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  communications CommunicationLog[]

  @@index([email])
  @@map("crm_leads")
}

model CommunicationLog {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  leadId    String?  @map("lead_id") @db.Uuid
  type      String   @default("NOTE") // CALL, EMAIL, MEETING, NOTE, IN_APP
  direction String   @default("OUTBOUND") // INBOUND, OUTBOUND
  subject   String?
  content   String?
  status    String   @default("COMPLETED")
  senderId  String?  @map("sender_id") @db.Uuid
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("communication_logs")
}

model SupportTicket {
  id              String   @id @default(uuid()) @db.Uuid
  ticketNumber    String?  @unique @map("ticket_number")
  customerId      String?  @map("customer_id") @db.Uuid
  assignedAgentId String?  @map("assigned_agent_id") @db.Uuid
  subject         String
  description     String
  priority        String   @default("medium") // low, medium, high, urgent, critical
  status          String   @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, ESCALATED, RESOLVED, CLOSED
  category        String   @default("GENERAL")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedAgent Profile?        @relation("TicketAssignee", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  senderId   String?  @map("sender_id") @db.Uuid
  senderType String   @default("CUSTOMER") @map("sender_type") // CUSTOMER, AGENT, SYSTEM
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender Profile?       @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@map("ticket_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMERCE & CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?  @map("short_description")
  basePrice        Decimal  @default(0) @map("base_price") @db.Decimal(12, 2)
  costPrice        Decimal? @map("cost_price") @db.Decimal(12, 2)
  sku              String   @unique
  status           String   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  categoryId       String?  @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  tags             String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants Variant[]

  @@map("products")
}

model Variant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique
  barcode       String?  @unique
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(12, 2)
  costPrice     Decimal? @map("cost_price") @db.Decimal(12, 2)
  attributes    Json     @default("{}")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  poItems         PurchaseOrderItem[]
  pickListItems   PickListItem[]

  @@map("variants")
}

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  code       String   @unique
  address    String?
  city       String?
  state      String?
  postalCode String?  @map("postal_code")
  country    String?  @default("BD")
  latitude   Float?
  longitude  Float?
  capacity   Int?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  pickLists       PickList[]

  @@map("warehouses")
}

model InventoryLevel {
  id                String   @id @default(uuid()) @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  quantityAvailable Int      @default(0) @map("quantity_available")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  reorderPoint      Int      @default(5) @map("reorder_point")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory_levels")
}

model StockMovement {
  id               String   @id @default(uuid()) @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  movementType     String   @map("movement_type") // IN, OUT, TRANSFER, ADJUSTMENT
  quantity         Int
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  referenceType    String?  @map("reference_type") // PO, ORDER, RETURN, MANUAL
  referenceId      String?  @map("reference_id")
  notes            String?
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String?  @unique @map("profile_id") @db.Uuid
  name        String
  email       String   @unique
  phone       String?
  address     String?
  groupId     String?  @map("group_id") @db.Uuid
  status      String   @default("active") // active, inactive, blocked
  notes       String?
  totalSpent  Decimal  @default(0) @map("total_spent") @db.Decimal(12, 2)
  ordersCount Int      @default(0) @map("orders_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  returns Return[]

  @@map("customers")
}

model CustomerGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isDynamic   Boolean  @default(false) @map("is_dynamic")
  rules       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customers Customer[]

  @@map("customer_segments")
}

model Campaign {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  type          String    @default("email") // email, push, sms
  subject       String?
  content       String?
  targetSegment String    @default("all") @map("target_segment")
  status        String    @default("draft") // draft, scheduled, sending, sent, completed, failed
  scheduleTime  DateTime? @map("schedule_time") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("marketing_campaigns")
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONS & FULFILLMENT
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  poNumber     String    @unique @map("po_number")
  supplierId   String?   @map("supplier_id") @db.Uuid
  warehouseId  String    @map("warehouse_id") @db.Uuid
  status       String    @default("DRAFT") // DRAFT, PENDING, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  expectedDate DateTime? @map("expected_date") @db.Timestamptz(6)
  notes        String?
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  variantId       String  @map("variant_id") @db.Uuid
  quantity        Int
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost       Decimal @map("total_cost") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model PickList {
  id              String    @id @default(uuid()) @db.Uuid
  pickListNumber  String    @unique @map("pick_list_number")
  warehouseId     String    @map("warehouse_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  assignedPickerId String?  @map("assigned_picker_id") @db.Uuid
  status          String    @default("PENDING") // PENDING, ASSIGNED, PICKING, PARTIALLY_PICKED, COMPLETED, CANCELLED
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     PickListItem[]

  @@map("pick_lists")
}

model PickListItem {
  id               String  @id @default(uuid()) @db.Uuid
  pickListId       String  @map("pick_list_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  quantityRequired Int     @map("quantity_required")
  quantityPicked   Int     @default(0) @map("quantity_picked")
  status           String  @default("PENDING") // PENDING, PICKED, SHORT
  location         String?

  pickList PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  variant  Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("pick_list_items")
}

model Return {
  id           String   @id @default(uuid()) @db.Uuid
  returnNumber String   @unique @map("return_number")
  orderId      String?  @map("order_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  status       String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, RECEIVED, REFUNDED, COMPLETED
  reason       String?
  notes        String?
  refundAmount Decimal  @default(0) @map("refund_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    ReturnItem[]

  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(uuid()) @db.Uuid
  returnId    String   @map("return_id") @db.Uuid
  orderItemId String?  @map("order_item_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  quantity    Int      @default(1)
  reason      String?
  condition   String   @default("good") // good, damaged, defective
  restocked   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_items")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
